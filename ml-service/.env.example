PORT=8000
MODEL_DIR=models
MODEL_VERSION=v1

# Where to pull reviewed alert labels from during retraining
BACKEND_URL=http://localhost:5000/api
BACKEND_EMAIL=engineer@bank.in
BACKEND_PASSWORD=Engineer@123

# Score blending inside the ML service itself:
# the supervised model carries most of the weight, the anomaly detector
# contributes a novelty signal for attack patterns never seen in training.
SUPERVISED_WEIGHT=0.75
ANOMALY_WEIGHT=0.25

# Explanation cost control — SHAP is the slowest part of a prediction
EXPLAIN_ENABLED=true
EXPLAIN_TOP_K=6

# ULB benchmark model (Kaggle mlg-ulb creditcardfraud)
ULB_MODEL_VERSION=ulb_v1
-e 
CSV_MODEL_VERSION=csv_v1
