# Server
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database
MONGO_URI=mongodb://127.0.0.1:27017/fraudguard
# Atlas example:
# MONGO_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/fraudguard

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h

# Score fusion
FUSION_STRATEGY=weighted        # weighted | max
FUSION_RULE_WEIGHT=0.4
FUSION_ML_WEIGHT=0.6

# Decision thresholds (upper bound of each band)
BAND_LOW_MAX=30
BAND_MEDIUM_MAX=60
BAND_HIGH_MAX=80

# ML service (Part 3). Leave ML_ENABLED=false to use the built-in fallback scorer.
ML_ENABLED=false
ML_SERVICE_URL=http://localhost:8000
ML_TIMEOUT_MS=250

# Seed admin
SEED_ADMIN_EMAIL=analyst@bank.in
SEED_ADMIN_PASSWORD=Analyst@123
